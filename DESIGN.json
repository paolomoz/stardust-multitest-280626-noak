{
  "schemaVersion": 2,
  "colors": {
    "navy": "#012169",
    "actionBlue": "#0053C2",
    "red": "#E31837",
    "ink": "#1A1A1A",
    "slate": "#5A5A5A",
    "background": "#FFFFFF",
    "surface": "#F5F6F8",
    "surfaceCool": "#EEF3FC"
  },
  "typography": {
    "heading": "Inter, Arial, sans-serif",
    "body": "Roboto, Arial, Helvetica, sans-serif",
    "base": "16px",
    "ratio": 1.25,
    "weights": ["400", "500", "700"]
  },
  "rounded": { "button": "24px", "card": "14px", "chip": "4px" },
  "spacing": { "base": "8px", "sectionPadding": { "desktop": "64px", "tablet": "48px", "mobile": "32px" } },
  "extensions": {
    "mode": "A (brand-faithful, single variant)",
    "brandSignal": "signal-strong",
    "iaFidelity": "verbatim",
    "density": "balanced (multi-audience hard floor honored)",
    "colorMeta": {
      "navy": "primary brand / dark surface / headings",
      "actionBlue": "links + primary action",
      "red": "flagscape accent — reserved for brand marks/emphasis, not body on tint"
    },
    "shadows": { "card": "0 2px 20px rgba(0,0,0,0.12)" },
    "motion": {
      "register": "arrival",
      "registerRationale": "PRODUCT.md Brand Personality: civic-formal + institutional",
      "durations": { "enter": 500, "stagger": 80 }
    },
    "divergence": {
      "seed": { "decade": "2025-now", "register": "civic-institutional", "ground_family": "stark-white" },
      "font_deck": { "name": "brand-inherited", "picked_by": "user-constraint" },
      "palette": { "source": "inherited from _brand-extraction.json", "picked_by": "user-constraint" },
      "brand_faithful_inversions": [
        "Retain flagscape navy #012169 and red #E31837 exactly (pure brand hexes).",
        "Connections substituted by Inter (proprietary face unavailable); Roboto body retained verbatim."
      ]
    },
    "componentStyle": {
      "buttons": "pill 24px; primary action-blue fill / secondary navy outline",
      "cards": "14px radius, soft shadow 0 2px 20px rgba(0,0,0,0.12), image-led",
      "inputs": "8px radius, navy focus ring"
    },
    "systemComponentRoles": {
      "header": { "purpose": "global utility + 4-pillar primary nav + flagscape logo + sign-in", "position": "top, sticky" },
      "footer": { "purpose": "product/company/legal links + FDIC + Equal Housing + social + copyright", "position": "bottom" },
      "trustStrip": { "purpose": "FDIC-Insured + Equal Housing Lender", "position": "near-footer / contextual" }
    },
    "iaPriorities": [
      { "signal": "commercial-conversion", "evidence": "pages/index.json hero offers + Open an account / Apply now CTAs", "preserveAs": "first-viewport", "scope": "site-wide", "mutability": "locked" },
      { "signal": "trust-affordance", "evidence": "FDIC-Insured strip present site-wide", "preserveAs": "persistent", "scope": "site-wide", "mutability": "locked" },
      { "signal": "audience-routing", "evidence": "Personal / Small Business / Wealth nav pillars", "preserveAs": "header", "scope": "site-wide", "mutability": "locked" }
    ],
    "voice": {
      "do": ["Plain benefit-led copy", "One ask per section", "Trust signals deliberate"],
      "dont": ["No auto carousel", "No competing CTA sprawl", "No SaaS gradient hero"]
    }
  },
  "narrative": {
    "northStar": "A calmer, more confident Bank of America — same identity and IA, one card system, one ask per section.",
    "rules": ["One primary CTA per band", "Flagscape red reserved for marks/emphasis", "AA contrast maintained"]
  }
}
