{
  "schemaVersion": 2,
  "colors": {
    "background": "#ffffff", "ink": "#0a0a0a", "surface": "#f4f4f4", "surfaceAlt": "#fafafa",
    "text": "#1a1a1a", "textMuted": "#5f5f5f", "border": "#e2e2e2",
    "accent": "#005bb0", "accentDeep": "#01498e", "onInk": "#ffffff"
  },
  "typography": {
    "headingFamily": "Inter, 'Helvetica Neue', Arial, sans-serif",
    "bodyFamily": "Inter, 'Helvetica Neue', Arial, sans-serif",
    "scaleRatio": 1.25, "weights": [400, 600, 700]
  },
  "rounded": "2px",
  "spacing": { "base": "4pt", "sectionPadding": { "desktop": "64px", "tablet": "48px", "mobile": "32px" } },
  "components": ["button-primary", "button-secondary", "card", "link", "badge", "input"],
  "extensions": {
    "mode": "A-brand-faithful",
    "brandSignal": "signal-strong",
    "density": "balanced (multi-audience hard floor)",
    "iaFidelity": "verbatim (faithful redesign, modernized)",
    "colorMeta": { "source": "inherited from _brand-extraction.json, modernized" },
    "typographyMeta": { "source": "SST substituted with Inter (unlicensed proprietary face)" },
    "motion": {
      "register": "editorial",
      "registerRationale": "PRODUCT.md Brand Personality: editorial, slow-paced, publication-register",
      "durations": { "enter": 500, "stagger": 80 },
      "carousel": { "intervalMs": 6000, "transition": "cross-fade", "reducedMotion": "hold-first-slide" }
    },
    "divergence": {
      "seed": { "decade": "2025-now", "register": "editorial", "ground_family": { "value": "stark-white", "override": "brand-faithful" } },
      "font_deck": { "name": "brand-inherited", "picked_by": "user-constraint" },
      "palette": { "source": "inherited from _brand-extraction.json", "picked_by": "user-constraint" },
      "brand_faithful_inversions": [
        { "field": "ink", "from": "#000000", "to": "#0a0a0a", "reason": "impeccable no-pure-black; modernized softer ink" },
        { "field": "background-pairing", "from": "#ffffff/#000000", "to": "#ffffff + #0a0a0a ink", "reason": "near-black retains brand monochrome" },
        { "field": "headingFamily", "from": "SST (proprietary)", "to": "Inter", "reason": "SST unlicensed; Inter is closest free humanist grotesque" }
      ]
    },
    "componentStyle": {
      "buttons": { "primary": "solid near-black, white text, 2px radius, no shadow", "secondary": "1px ink outline, transparent" },
      "cards": { "treatment": "white, 1px #e2e2e2 border, 2px radius, image-top + label, subtle hover lift" },
      "dualCTAPattern": "avoid (anti-ref: SaaS dual primary CTAs); one primary + one text link"
    },
    "systemComponentRoles": {
      "header": { "purpose": "global mega-nav + wordmark", "positionClass": "sticky-top" },
      "footer": { "purpose": "multi-column corporate links + legal row", "positionClass": "page-end" },
      "hero-carousel": { "purpose": "signature auto-rotating brand-story hero", "positionClass": "home-first-viewport" }
    },
    "iaPriorities": [
      { "signal": "audience-routing", "evidence": "home + global nav route to products/tech/sustainability/design/careers/IR/news", "preserveAs": "global-nav", "scope": "site-wide", "mutability": "locked" },
      { "signal": "signature-motion", "evidence": "_brand-extraction.json#voice.heroMedium = auto-rotating image carousel", "preserveAs": "first-viewport", "scope": "home", "mutability": "locked" }
    ],
    "voice": {
      "do": ["mixed-case editorial headlines", "concise neutral corporate prose", "let photography speak"],
      "dont": ["uppercase shouting", "marketing hyperbole", "dual primary CTAs"]
    }
  },
  "narrative": {
    "northStar": "A modern editorial corporate portal that feels unmistakably Sony — near-monochrome, image-forward, quiet, confident.",
    "overview": "Faithful-modernized refresh of the Sony Group Portal across home, section-landing, listing, article, and editorial templates.",
    "keyCharacteristics": ["monochrome restraint", "image-forward", "editorial whitespace", "signature auto-carousel"],
    "rules": ["near-black not pure black", "one accent blue only", "mixed-case headings", "scrim under hero text"]
  }
}
