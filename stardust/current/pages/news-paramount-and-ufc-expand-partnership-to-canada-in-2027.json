  "title": "Paramount and UFC Expand Partnership to Canada in 2027 | Paramount",
  "description": null,
  "og": {
    "title": "Paramount and UFC Expand Partnership to Canada in 2027 | Paramount",
    "description": null,
    "image": "https://www.paramount.com/sites/g/files/dxjhpe356/files/ParamountDotCom/HomePage/Images/Skydance%20Merger%202025/Metadata%20logo/metadata-image.png",
