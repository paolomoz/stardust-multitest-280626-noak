{
  "colors": {
    "primary": "#006241",
    "primaryBright": "#008248",
    "primaryClassic": "#00754A",
    "deep": "#1E3932",
    "background": "#FFFFFF",
    "surface": "#F1F8F5",
    "text": "rgba(0,0,0,0.87)",
    "textMuted": "rgba(0,0,0,0.58)",
    "border": "rgba(0,0,0,0.12)"
  },
  "typography": {
    "heading": "SoDoSans, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "body": "SoDoSans, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "weights": [
      400,
      600,
      700
    ]
  },
  "rounded": "pill",
  "spacing": "generous",
  "components": [
    "hero-tile",
    "product-card-grid",
    "editorial-row",
    "pill-cta",
    "siren-badge",
    "footer-columns"
  ],
  "extensions": {
    "componentStyle": {
      "radius": [
        {
          "value": "50px",
          "use": "pill buttons / CTAs",
          "weight": 10
        },
        {
          "value": "8px",
          "use": "cards/images",
          "weight": 1
        }
      ],
      "shadows": [
        "rgba(0,0,0,0.1) 0 1px 3px, rgba(0,0,0,0.06) 0 2px 2px, rgba(0,0,0,0.07) 0 0 2px (card)",
        "rgba(0,0,0,0.24) 0 2px 4px (raised)"
      ],
      "patterns": [
        "full-bleed image hero tiles with text overlay",
        "pill CTA buttons",
        "product card grid (circular product image, name, short desc)",
        "circular Siren badge",
        "alternating editorial image+text rows"
      ]
    },
    "motifs": [
      "full-bleed image hero tiles with text overlay",
      "pill CTA buttons",
      "product card grid (circular product image, name, short desc)",
      "circular Siren badge",
      "alternating editorial image+text rows"
    ],
    "voice": {
      "register": "brand",
      "heroHeadline": "New: Blue coconut for a cause",
      "heroImage": "https://content-prod-live.cert.starbucks.com/binary/v2/asset/137-108864.jpg",
      "heroMedium": null,
      "tagline": "It's a great day for coffee",
      "ctas": [
        "Start an order",
        "Order now",
        "Join now",
        "Find a store",
        "Explore the summer menu"
      ],
      "samples": [
        "It's a great day for coffee",
        "It's Starbucks summer",
        "Bold, iced and deliciously classic",
        "Good energy in every sip"
      ]
    },
    "systemComponents": {
      "header": {
        "logo": "Siren badge",
        "nav": [
          "Menu",
          "Rewards",
          "Gift Cards",
          "Find a store"
        ],
        "actions": [
          "Sign in",
          "Join now"
        ]
      },
      "footer": {
        "columns": {
          "About Us": [
            "Our Company",
            "Our Heritage",
            "Coffee & Craft",
            "Our Partners"
          ],
          "Careers": [
            "Culture and Values",
